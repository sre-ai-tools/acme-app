# Copy to .env.local and fill in from `terraform output` in infra/.
# Optional: defaults to /api, which CloudFront routes to the API. Set it for local development.
VITE_API_URL=https://abc123.execute-api.us-east-1.amazonaws.com
VITE_COGNITO_DOMAIN=https://acme-incident-log.auth.us-east-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=exampleclientid
# Must be one of the Cognito client's callback URLs.
VITE_REDIRECT_URI=http://localhost:5173/
